@startuml
title TripForge - przypadki uzycia
left to right direction

actor Uzytkownik
actor Uczestnik
actor Organizator
Uczestnik -|> Uzytkownik
Organizator -|> Uczestnik

rectangle TripForge {
  usecase "Zaloguj sie" as UC5
  usecase "Weryfikuj dane logowania" as UC5a
  usecase "Pokaz blad logowania" as UC5b
  usecase "Zaznacz dostepnosc" as UC1
  usecase "Pokaz dostepnosc grupy" as UC1a
  usecase "Glosuj na propozycje" as UC2
  usecase "Aktualizuj liczbe glosow" as UC2a
  usecase "Dodaj wydarzenie\ndo harmonogramu" as UC3
  usecase "Przegladaj harmonogram" as UC3a
  usecase "Sprawdz szacunkowy koszt" as UC4
  usecase "Oblicz koszt na osobe" as UC4a
}

Uzytkownik --> UC5
Uczestnik --> UC1
Uczestnik --> UC2
Uczestnik --> UC3a
Uczestnik --> UC4
Organizator --> UC3

UC5 ..> UC5a : <<include>>
UC5b ..> UC5 : <<extend>>
UC1 ..> UC1a : <<include>>
UC2 ..> UC2a : <<include>>
UC3 ..> UC3a : <<include>>
UC4 ..> UC4a : <<include>>
@enduml
